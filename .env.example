# Copy to .env and fill in. Never commit .env.

# PostgreSQL/TimescaleDB. The tests use a "rada_test" database on the same server.
DATABASE_URL=postgresql://rada:rada@localhost:5432/rada_dev

# API key auth. With AUTH_ENABLED=false, no key is needed (local development only).
AUTH_ENABLED=false
API_KEY=change-me

# development or staging enables Swagger at /docs; production disables it.
ENVIRONMENT=development

# Telemetry simulator
TELEMETRY_SIMULATOR=false
SIMULATOR_INTERVAL_SEC=600
API_BASE_URL=http://localhost:8000

# vLLM (OpenAI-compatible). Required: the app refuses to start without it.
VLLM_BASE_URL=http://localhost:8001/v1
# VLLM_API_KEY=not-needed
# VLLM_MODEL=Qwen/Qwen2.5-7B-Instruct

# RTE OAuth2 credentials, for grid_signal_fetcher.py
# RTE_GENERATION_CLIENT_ID=
# RTE_GENERATION_CLIENT_SECRET=
# RTE_BALANCING_CLIENT_ID=
# RTE_BALANCING_CLIENT_SECRET=
