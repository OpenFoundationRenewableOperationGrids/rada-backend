# Copy to .env and fill in. Never commit .env.

# PostgreSQL/TimescaleDB. The tests use a "rada_test" database on the same server.
DATABASE_URL=postgresql://rada:rada@localhost:5432/rada_dev

# Sign-in, roles and API keys (docs/AUTH.md). AUTH_ENABLED=false makes every
# request an administrator; it is refused unless ENVIRONMENT=development.
AUTH_ENABLED=false
# Signs session tokens. Required when AUTH_ENABLED=true (at least 32 characters):
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
SESSION_SECRET=
# SESSION_TTL_HOURS=8
# false only for local http (the session cookie is Secure by default)
COOKIE_SECURE=false
# Origins of the front end, comma-separated (CORS, and cookie writes from a browser)
# CORS_ORIGINS=http://localhost:3000
# Optional: POST /auth/setup then needs the X-Setup-Token header with this value
# SETUP_TOKEN=
# Behind Traefik, so that failed sign-ins are counted per client and not per proxy
# (uvicorn reads it): the address of the proxy, or * if only the proxy can reach the API
# FORWARDED_ALLOW_IPS=*
# Deprecated: the MVP's single shared key, accepted with full access until the front
# end and the bridge use named keys. Removed before the release (BE-09). Leave empty.
API_KEY=

# development or staging enables Swagger at /docs; production disables it.
ENVIRONMENT=development

# Telemetry simulator
TELEMETRY_SIMULATOR=false
SIMULATOR_INTERVAL_SEC=600
# A named API key with the admin scope (reads assets, posts telemetry); falls back to API_KEY
# SIMULATOR_API_KEY=
API_BASE_URL=http://localhost:8000

# vLLM (OpenAI-compatible). Required: the app refuses to start without it.
VLLM_BASE_URL=http://localhost:8001/v1
# VLLM_API_KEY=not-needed
# VLLM_MODEL=Qwen/Qwen2.5-7B-Instruct

# RTE OAuth2 credentials, for grid_signal_fetcher.py
# RTE_GENERATION_CLIENT_ID=
# RTE_GENERATION_CLIENT_SECRET=
# RTE_BALANCING_CLIENT_ID=
# RTE_BALANCING_CLIENT_SECRET=

# OpenEMS bridge (python -m bridge). The Backends and assets are listed in
# bridge/connections.toml (copy bridge/connections.example.toml).
# BRIDGE_CONFIG=bridge/connections.toml
# RADA_API_URL=http://localhost:8000
# RADA_API_KEY=change-me
# Credentials for each OpenEMS Backend, named in connections.toml:
# OPENEMS_VPS_USER=
# OPENEMS_VPS_PASSWORD=
